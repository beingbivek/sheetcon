// prisma/schema.prisma
// FULL FILE — complete replacement

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvedPayments PaymentRequest[] @relation("ApprovedBy")
  rejectedPayments PaymentRequest[] @relation("RejectedBy")

  @@index([email])
}

model Tier {
  id               String       @id @default(cuid())
  name             String       @unique
  slug             String       @unique
  description      String?
  price            Float        @default(0)
  currency         String       @default("NPR")
  billingCycle     BillingCycle @default(MONTHLY)
  annualPrice      Float?
  maxUsers         Int          @default(-1)
  currentUserCount Int          @default(0)
  maxSheets        Int          @default(1)
  maxTemplates     Int          @default(1)
  maxCrudPerDay    Int          @default(1000)
  customBranding   Boolean      @default(false)
  prioritySupport  Boolean      @default(false)
  exportToPdf      Boolean      @default(true)
  isActive         Boolean      @default(true)
  displayOrder     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users           User[]
  paymentRequests PaymentRequest[]

  @@index([slug])
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  name                  String?
  image                 String?
  passwordHash          String?
  tierId                String
  googleId              String?            @unique
  accessToken           String?
  refreshToken          String?
  isActive              Boolean            @default(true)
  emailVerified         Boolean            @default(false)
  crudCountToday        Int                @default(0)
  lastCrudReset         DateTime           @default(now())
  subscriptionExpiresAt DateTime?
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  banReason             String?
  isBanned              Boolean            @default(false)
  lastLoginAt           DateTime?

  sheetConnections SheetConnection[]
  tier             Tier              @relation(fields: [tierId], references: [id])
  paymentRequests  PaymentRequest[]

  @@index([email])
  @@index([tierId])
  @@index([subscriptionStatus, subscriptionExpiresAt])
}

model SheetConnection {
  id              String    @id @default(cuid())
  userId          String
  sheetType       String
  spreadsheetId   String
  spreadsheetName String
  spreadsheetUrl  String
  templateId      String?
  templateLocked  Boolean   @default(false)
  lockedAt        DateTime?
  columnMappings  Json?
  isActive        Boolean   @default(true)
  lastSyncedAt    DateTime?
  syncStatus      String    @default("PENDING")
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        BusinessProduct[]
  suppliers       BusinessSupplier[]
  customers       BusinessCustomer[]
  purchases       BusinessPurchase[]
  sales           BusinessSale[]
  config          BusinessConfig?
  businessOrders  BusinessOrder[]
  businessReturns BusinessReturn[]

  @@unique([userId, spreadsheetId])
  @@index([userId, isActive])
}

model Template {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  icon         String   @default("📋")
  configSchema Json
  primaryColor String   @default("#3b82f6")
  features     String[] @default([])
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(true)
  version      String   @default("1.0.0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([isActive, isPublic])
}

model PaymentRequest {
  id                    String        @id @default(cuid())
  invoiceId             String        @unique
  userId                String
  requestedTierId       String
  requestedBillingCycle BillingCycle
  requestedTierName     String
  amountSnapshot        Float
  currency              String        @default("NPR")
  paymentMethod         PaymentMethod @default(ESEWA_QR)
  status                PaymentStatus @default(AWAITING_PAYMENT)
  screenshotUrl         String?
  transactionReference  String?
  payerAccount          String?
  userNote              String?
  submittedAt           DateTime?
  adminNote             String?
  rejectionReason       String?
  approvedByAdminId     String?
  rejectedByAdminId     String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  expiresAt             DateTime
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedTier Tier   @relation(fields: [requestedTierId], references: [id])
  approvedBy    Admin? @relation("ApprovedBy", fields: [approvedByAdminId], references: [id])
  rejectedBy    Admin? @relation("RejectedBy", fields: [rejectedByAdminId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([invoiceId])
}

model PaymentSettings {
  id           String   @id @default(cuid())
  esewaId      String
  esewaName    String
  esewaPhone   String?
  qrCodeData   String
  qrImageUrl   String?
  instructions String   @default("1. Scan QR or send to eSewa ID\n2. Enter exact amount\n3. Copy Invoice ID to remarks\n4. Upload payment screenshot")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model QrImage {
  id         String   @id @default(cuid())
  label      String
  imageUrl   String
  isActive   Boolean  @default(false)
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BusinessProduct {
  id                String @id
  sheetConnectionId String
  externalSheetId   String
  sheetRowIndex     Int?

  name         String
  sku          String?
  variation    String?
  category     String?
  description  String?
  costPrice    Float   @default(0)
  sellingPrice Float   @default(0)
  stock        Float   @default(0)
  minStock     Float   @default(0)
  unit         String?
  supplierId   String?
  supplierName String?
  imageUrl     String?
  // ── TASK 4: tax pricing flag ──
  pricedWithTax Boolean @default(false)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  sheetConnection SheetConnection @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([syncStatus])
}

model BusinessSupplier {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  name          String
  phone         String?
  email         String?
  address       String?
  city          String?
  contactPerson String?
  paymentTerms  String?
  notes         String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  sheetConnection SheetConnection @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([syncStatus])
}

model BusinessCustomer {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  name         String
  phone        String?
  email        String?
  address      String?
  city         String?
  customerType String  @default("WALK_IN")
  notes        String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  sheetConnection SheetConnection @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([syncStatus])
}

model BusinessPurchase {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  invoiceNumber String
  date          String
  supplierId    String?
  supplierName  String?
  subtotal      Float   @default(0)
  taxPercent    Float   @default(0)
  taxAmount     Float   @default(0)
  transportCost Float   @default(0)
  customsCost   Float   @default(0)
  storageCost   Float   @default(0)
  otherExpenses Float   @default(0)
  landedCost    Float   @default(0)
  total         Float   @default(0)
  amountPaid    Float   @default(0)
  amountDue     Float   @default(0)
  status        String  @default("UNPAID")
  imageUrl      String?
  notes         String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  items           BusinessPurchaseItem[]
  sheetConnection SheetConnection        @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([syncStatus])
}

model BusinessPurchaseItem {
  id          String @id
  purchaseId  String
  productId   String
  productName String
  quantity    Float  @default(0)
  unitPrice   Float  @default(0)
  total       Float  @default(0)

  purchase BusinessPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model BusinessSale {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  invoiceNumber  String
  date           String
  customerId     String?
  customerName   String?
  subtotal       Float   @default(0)
  discountType   String?
  discountValue  Float   @default(0)
  discountAmount Float   @default(0)
  taxPercent     Float   @default(0)
  taxAmount      Float   @default(0)
  total          Float   @default(0)
  amountPaid     Float   @default(0)
  amountDue      Float   @default(0)
  paymentMethod  String?
  status         String  @default("UNPAID")
  notes          String?
  // ── TASK 1: sale type ──
  saleType       String  @default("WALK_IN") // WALK_IN | ONLINE

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  items           BusinessSaleItem[]
  sheetConnection SheetConnection    @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([syncStatus])
}

model BusinessSaleItem {
  id          String  @id
  saleId      String
  productId   String
  productName String
  variation   String?
  quantity    Float   @default(0)
  unitPrice   Float   @default(0)
  total       Float   @default(0)

  sale BusinessSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model BusinessOrder {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  orderNumber     String
  date            String
  customerId      String?
  customerName    String?
  customerPhone   String?
  customerAddress String?

  subtotal       Float   @default(0)
  deliveryFee    Float   @default(0)
  discountAmount Float   @default(0)
  total          Float   @default(0)
  amountPaid     Float   @default(0)
  amountDue      Float   @default(0)
  paymentMethod  String?
  paymentStatus  String  @default("UNPAID")

  status String @default("PENDING")

  notes        String?
  confirmedAt  DateTime?
  packedAt     DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  returnedAt   DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  items           BusinessOrderItem[]
  delivery        BusinessDelivery?
  sheetConnection SheetConnection     @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([status])
  @@index([syncStatus])
}

model BusinessOrderItem {
  id          String  @id
  orderId     String
  productId   String
  productName String
  variation   String?
  quantity    Float   @default(0)
  unitPrice   Float   @default(0)
  total       Float   @default(0)

  order BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BusinessDelivery {
  id      String @id @default(cuid())
  orderId String @unique

  agentType    String
  agentName    String
  agentPhone   String?
  courierName  String?
  trackingCode String?
  deliveryFee  Float   @default(0)
  notes        String?

  assignedAt  DateTime  @default(now())
  deliveredAt DateTime?

  order BusinessOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BusinessReturn {
  id                String @id
  sheetConnectionId String
  externalSheetId   String

  returnNumber String
  returnType   String
  date         String

  saleId       String?
  saleInvoice  String?
  customerId   String?
  customerName String?

  purchaseId      String?
  purchaseInvoice String?
  supplierId      String?
  supplierName    String?

  reason String?
  notes  String?
  status String  @default("PENDING")

  totalValue   Float   @default(0)
  refundAmount Float   @default(0)
  refundMethod String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  items           BusinessReturnItem[]
  sheetConnection SheetConnection      @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@unique([sheetConnectionId, id])
  @@index([sheetConnectionId, externalSheetId])
  @@index([returnType])
  @@index([status])
  @@index([syncStatus])
}

model BusinessReturnItem {
  id          String @id
  returnId    String
  productId   String
  productName String
  quantity    Float  @default(0)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  condition   String @default("DAMAGED")

  return BusinessReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model BusinessConfig {
  id                String @id @default(cuid())
  sheetConnectionId String @unique
  externalSheetId   String

  businessName      String?
  logoUrl           String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxNumber         String?
  currency          String?
  currencySymbol    String?
  paymentQrUrl      String?
  invoicePrefix     String?
  invoiceFooter     String?
  lowStockThreshold String?
  // ── TASK 5: global default tax rate ──
  defaultTaxRate    String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSyncedAt DateTime?
  syncStatus   SyncStatus @default(SYNCED)
  syncError    String?

  sheetConnection SheetConnection @relation(fields: [sheetConnectionId], references: [id], onDelete: Cascade)

  @@index([sheetConnectionId])
  @@index([syncStatus])
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  LIFETIME
}

enum PaymentMethod {
  ESEWA_QR
  KHALTI
  BANK_TRANSFER
  MANUAL
}

enum PaymentStatus {
  AWAITING_PAYMENT
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}